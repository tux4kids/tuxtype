msgid "Setup Language"
msgstr "மொழியை அமை"

msgid "Edit Word Lists"
msgstr "சொல் பட்டியலை திருத்து"

msgid "Setup Braille Keys"
msgstr "பிரெய்லி விசைகளை அமை"

msgid "Main Menu"
msgstr "முதன்மை மெனு"

msgid "Fish Cascade"
msgstr "மீன் மழை"

msgid "Comet Zap"
msgstr "வால்நட்சத்திர தாக்குதல்"

msgid "Training"
msgstr "பயிற்சி"

msgid "Options"
msgstr "விருப்பங்கள்"

msgid "Project Info"
msgstr "திட்ட தகவல்"

msgid "Quit"
msgstr "வெளியேறு"

msgid "Easy"
msgstr "எளியது"

msgid "Medium"
msgstr "நடுத்தரம்"

msgid "Hard"
msgstr "கடினம்"

msgid "Space Cadet"
msgstr "விண்வெளி வீரர்"

msgid "Pilot"
msgstr "பைலட்"

msgid "Ace"
msgstr "ஏஸ்"

msgid "Commander"
msgstr "தளபதி"

msgid "Basic Lessons"
msgstr "அடிப்படை பாடங்கள்"

msgid "Phrase Typing"
msgstr "சொற்றொடர் தட்டச்சு"

msgid "Instructions"
msgstr "அறிவுறுத்தல்கள்"

msgid "Moderate"
msgstr "மிதமான"

msgid "Hardest"
msgstr "மிகக் கடினமான"

msgid "Help Tux eat fish by pressing the letters on the fish"
msgstr "மீன் மீதுள்ள எழுத்துகளை அழுத்தி டக்ஸ் மீன் சாப்பிட உதவுங்கள்"

msgid "Defend the cities from comets by typing letter on them using laser!"
msgstr "லேசர் மூலம் எழுத்துகளை தட்டச்சு செய்து நகரங்களை காப்பாற்றுங்கள்!"

msgid "Train alphabets and phrase typing"
msgstr "எழுத்துக்கள் மற்றும் சொற்றொடர்களை தட்டச்சு செய்ய பயிற்சி பெறவும்"

msgid "Train basic alphabets"
msgstr "அடிப்படை எழுத்துக்களை பயிற்சி செய்யவூம்"

msgid "Train typing sentences"
msgstr "வாக்கியங்களை தட்டச்சு செய்ய பயிற்சி பெறவும்"

msgid "Additional options"
msgstr "கூடுதல் விருப்பங்கள்"

msgid "Set your language"
msgstr "உங்கள் மொழியைத் தேர்ந்தெடுக்கவும்"

msgid "Add or remove words"
msgstr "சொற்களைச் சேர்க்கவும் அல்லது நீக்கவும்"

msgid "Choose your own keys for representing braille dots"
msgstr "பிரெய்லி புள்ளிகளுக்கான விசைகளைத் தேர்ந்தெடுக்கவும்"

msgid "See the project info"
msgstr "திட்ட தகவலைப் பார்க்கவும்"

msgid "Exit to your desktop"
msgstr "திரைக்குச் செல்லவும்"

msgid "Return to the main menu"
msgstr "முதன்மை மெனுவிற்குத் திரும்பவும்"


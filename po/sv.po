#: src/editor.c:159
msgid "Word List Editor"
msgstr "Ordlistredigerare"

#: src/editor.c:160
msgid "To add a new word list, click the 'NEW' button"
msgstr "Klicka på NY för att skapa en ordlista."

#: src/editor.c:161
msgid ""
"To remove a word list, select the wordlist with the arrow buttons, then "
"click the 'REMOVE' button or the 'DELETE' key"
msgstr ""
"Välj en ordlista med piltangenterna och klicka på TA BORT eller tryck på "
"Backsteg."

#: src/editor.c:162
msgid ""
"To edit a word list, select the wordlist with the arrow buttons, then press "
"the 'RETURN' key"
msgstr ""
"Välj en ordlista med piltangenterna och tryck på Enter för att redigera den."

#: src/editor.c:163
msgid ""
"To exit Word List Editor, press the 'ESC' key, or click on the 'DONE' button"
msgstr "Tryck på Esc eller klicka på KLAR för att avsluta."

#: src/editor.c:165
msgid "WWWWWWWWW"
msgstr "WWWWWWWWW"

#: src/editor.c:167
msgid "NEW"
msgstr "NY"

#: src/editor.c:168
msgid "DONE"
msgstr "KLAR"

#: src/editor.c:169
msgid "REMOVE"
msgstr "TA BORT"

#: src/editor.c:579
msgid "Word List Editor:"
msgstr "Ordlistredigerare:"

#: src/editor.c:582
msgid "To add a word, press 'RETURN' and start typing"
msgstr "Tryck på Enter och skriv ett nytt ord."

#: src/editor.c:583
msgid ""
"To edit a word, select the word using the arrow buttons and continue typing"
msgstr ""
"Välj ett ord med piltangenterna och fortsätt skriva för att ändra det."

#: src/editor.c:584
msgid ""
"To delete a character, select the word you want to edit and press the "
"'DELETE' key"
msgstr "Välj ett ord och tryck på Backsteg för att ta bort det sista tecknet."

#: src/editor.c:585
msgid "To exit and save the word list, press 'ESC'"
msgstr "Tryck på Esc för att spara ordlistan och avsluta."

#: src/editor.c:1005 src/editor.c:1247
msgid "OK"
msgstr "OK"

#: src/editor.c:1006
msgid "CANCEL"
msgstr "AVBRYT"

#: src/editor.c:1009
msgid "Create a New Wordlist"
msgstr "Skapa en ny ordlista"

#: src/editor.c:1010
msgid "Type the name of your new wordlist and press 'ok' or 'RETURN' to save"
msgstr ""
"Skriv ett namn på ordlistan. Klicka på OK eller tryck på Enter för att "
"spara."

#: src/editor.c:1248
msgid "NEVERMIND"
msgstr "AVBRYT"

#: src/editor.c:1253
msgid "Do you want to delete this wordlist:"
msgstr "Vill du ta bort den här ordlistan?"


msgid "Help Tux eat fish by pressing the letters on the fish"
msgstr "ಮೀನಿನ ಮೇಲಿನ ಅಕ್ಷರಗಳನ್ನು ಒತ್ತುವ ಮೂಲಕ ಟಕ್ಸ್ ಮೀನು ತಿನ್ನಲು ಸಹಾಯ ಮಾಡಿ"

msgid "Defend the cities from comets by typing letter on them using laser!"
msgstr "ಲೇಸರ್ ಬಳಸಿ ಅಕ್ಷರಗಳನ್ನು ಟೈಪ್ ಮಾಡುವ ಮೂಲಕ ನಗರಗಳನ್ನು ರಕ್ಷಿಸಿ!"

msgid "Train alphabets and phrase typing"
msgstr "ಅಕ್ಷರಮಾಲೆ ಮತ್ತು ವಾಕ್ಯ ಟೈಪಿಂಗ್ ಅಭ್ಯಾಸ ಮಾಡಿ"

